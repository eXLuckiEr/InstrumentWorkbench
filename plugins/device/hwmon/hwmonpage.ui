        </item>
        <item>
         <widget class="QLabel" name="errorLabel">
          <property name="styleSheet"><string>color: #c62828;</string></property>
          <property name="wordWrap"><bool>true</bool></property>
         </widget>
        </item>
       </layout>
      </item>
      <item>
       <widget class="QLabel" name="hintLabel">
        <property name="text"><string>The divisor turns the raw number into the unit (hwmon gives milliamperes: 1; amperes: 1000). A * in the path is fine: the hwmon numbers change between boots. Options: min=N max=N (the tile turns red outside), text (a state, shown as it is) with expect=VALUE (red when it differs); {} in the name makes a tile for every file the * matches. Lines starting with # are comments. Nothing is installed on the device.</string></property>
        <property name="wordWrap"><bool>true</bool></property>
       </widget>
      </item>
     </layout>
    </widget>
