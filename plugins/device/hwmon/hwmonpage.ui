         <widget class="QCheckBox" name="preciseCheck">
          <property name="text"><string>Precise timing ($EPOCHREALTIME, bash 5)</string></property>
          <property name="toolTip"><string>On: the device stamps every sample and keeps the period without drift. Off: simple mode, needs only bash 4; the samples are stamped when they arrive.</string></property>
